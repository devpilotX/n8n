# ============================================================
# EXAMPLE ONLY - copy to /opt/n8n/.env and fill with real values.
# The real /opt/n8n/.env is chmod 600 and is NEVER committed.
# ============================================================

# 32-byte hex. Generate with:  openssl rand -hex 32
# LOSING THIS KEY = LOSING ALL STORED CREDENTIALS IN n8n.
N8N_ENCRYPTION_KEY=replace_me_openssl_rand_hex_32

# Password for the Postgres role 'n8n_user'. Generate with: openssl rand -hex 24
DB_POSTGRESDB_PASSWORD=replace_me_strong_db_password
